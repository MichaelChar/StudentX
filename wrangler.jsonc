{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studentx",
  // Expose the Worker on Cloudflare's free `*.workers.dev` subdomain so the
  // deployment has a public URL even before a custom domain is wired up.
  // The hostname will be `studentx.<account-subdomain>.workers.dev`. Safe
  // to leave on alongside a future custom domain — both serve the same code.
  "workers_dev": true,
  // cf/worker-entry.mjs wraps .open-next/worker.js to add a `scheduled` handler
  // (OpenNext v1.x doesn't ship one). The wrapper imports the built worker, so
  // `npm run cf:build` must have run before `wrangler deploy`.
  "main": "cf/worker-entry.mjs",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // EXPERIMENT (#262): Smart Placement. Most authed routes make 1–3 sequential
  // Supabase calls (auth-verify fallback, requireStudent/requireLandlord + page
  // queries, /api/auth/bootstrap, the server-rendered dashboard); running the
  // Worker near the DB beats running near the user for those. Public pages are
  // CDN-cached and unaffected. Needs 24–48 h of traffic to learn — measure
  // /api/auth/me, /student/account, /student/login TTFB before vs after (see
  // #262). Decision rule: keep if authed/API TTFB improves and login TTFB
  // doesn't regress > ~50 ms; otherwise remove this key and redeploy.
  "placement": { "mode": "smart" },
  // Persist Worker logs to Cloudflare's dashboard (Workers Logs) instead of
  // relying solely on `wrangler tail`, which is ephemeral and only shows what
  // happens while someone is actively watching. Two incidents made the case:
  // a cron trigger silently stopped firing for 3 days (PR #150), and a deploy
  // failure could only be diagnosed by downloading the build log by hand.
  //
  // `enabled` defaults to true for Workers created after this feature shipped;
  // this Worker predates it, so it must be set explicitly. Billed per log event
  // above a daily free allowance — negligible at current traffic. If volume
  // grows, add `head_sampling_rate` (0–1) rather than turning this off.
  "observability": { "enabled": true },
  // Workers AI binding — powers site-agnostic listing extraction
  // (@cf/meta/llama-3.1-8b-instruct) in the pending-listings ingest pipeline.
  // No external API keys. Only bound on the Worker (preview/deploy), NOT in
  // `next dev`; route handlers read it via getCloudflareContext().env.AI.
  // NB: the pending tables + photos live in Supabase Postgres + a `pending-photos`
  // Storage bucket (migration 059), so no D1/R2 bindings are needed here.
  "ai": { "binding": "AI" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Self service-binding so the Worker can invoke its own routes without
  // going through the network. Used by the synthetic-en-listing cron to
  // dodge the Worker self-fetch issues observed on both studentx.uk
  // (returns 522 — see PR #133's findings) and the workers.dev URL
  // (asset binding intercepts /api/* with 404). With this binding,
  // env.WORKER_SELF_REFERENCE.fetch(url) bypasses the network entirely
  // and goes straight to the Worker's fetch handler — same response
  // body and headers, no DNS or asset-binding fragility. Name follows
  // OpenNext's typed convention (CloudflareEnv["WORKER_SELF_REFERENCE"]
  // in @opennextjs/cloudflare).
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "studentx" }
  ],
  // Public Supabase config — these are also inlined into the client bundle
  // via NEXT_PUBLIC_*, but server-side route handlers (e.g. /api/listings)
  // read them from process.env at runtime in the Worker. Without these,
  // every Supabase-backed API route 500s because getSupabase() throws on
  // missing env. Anon key is RLS-protected and intentionally public.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ecluqurlfbvkxrnoyhaq.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVjbHVxdXJsZmJ2a3hybm95aGFxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ3ODQ0MzUsImV4cCI6MjA5MDM2MDQzNX0.XspsrkDjv_AWltPgFqBQSocLXU4tBmq1auu_Zg8qTBE",
    // Canonical/sitemap/og:url + landlord email links all resolve from these.
    // NEXT_PUBLIC_* are inlined at build time, so any local .env.local with a
    // dev URL (http://localhost:3000) leaks into the build unless overridden
    // explicitly at build (or the Worker is built from CI with no .env.local).
    "NEXT_PUBLIC_SITE_URL": "https://studentx.uk",
    "NEXT_PUBLIC_APP_URL": "https://studentx.uk",
    // Synthetic uptime check — guards against the i18n regression class fixed
    // in PR #48 (Greek copy leaking onto /en/listing/<id>). The */15 cron POSTs
    // to /api/cron/synthetic-en-listing, which fetches /en/listing/<id> and
    // emails alerts on locale-marker mismatches. See docs/runbooks/synthetic-en-listing.md.
    "SYNTHETIC_LISTING_ID": "0106002",
    "SYNTHETIC_ALERT_EMAIL": "michaeltubehd007@gmail.com"
  },
  // Cron triggers. Dispatched via cf/worker-entry.mjs's `scheduled` handler,
  // which maps each cron expression to a route and invokes OpenNext fetch
  // with CRON_SECRET. Keep cf/worker-entry.mjs's CRON_ROUTES in sync.
  //
  // W9 master tick: ONE trigger every 5 minutes → /api/cron/tick, which
  // holds a job registry (cadence per job, wall-clock dueness). Adding a
  // marketplace timer is a registry line — no new CF trigger, no Free-plan
  // slot. Free plan still caps at 5 triggers (6th → silent API error 10072).
  //
  // Job cadences (see src/app/api/cron/tick/route.js CRON_JOBS):
  //   recompute-distances   daily@09:15  faculty_distances heal
  //   message-digest        5m           landlord + student digests (merged)
  //   synthetic-en-listing  15m          i18n / uptime canaries (#49)
  //
  // Old per-job routes remain as manual-trigger wrappers.
  // Custom-domain routes. Wrangler creates the apex A record and www CNAME
  // automatically (both proxied). Requires the CF zone to be Active first
  // (see docs/runbooks/domain-setup.md step 6).
  "routes": [
    { "pattern": "studentx.uk", "custom_domain": true },
    { "pattern": "www.studentx.uk", "custom_domain": true }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"    // master tick → /api/cron/tick (job registry)
    ]
  }
}
