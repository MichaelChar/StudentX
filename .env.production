# ⚠ THIS FILE IS COMMITTED TO A PUBLIC REPO. NEXT_PUBLIC_* VALUES ONLY.
#
# Never put a server secret here — SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY,
# CRON_SECRET and friends go in `wrangler secret put NAME --name studentx`.
#
# Everything below is public by construction: it ships in the client bundle
# whatever we do, so secrecy is not what protects it (RLS protects the anon
# key; a domain restriction protects the CARTO key).
#
# The `secret-scan` CI job is the backstop if this rule is ever forgotten, and
# it allowlists the two values below BY EXACT VALUE — so a service-role key
# added to this file fails the build rather than shipping quietly. See
# .gitleaks.toml. Issue #251.

NEXT_PUBLIC_SUPABASE_URL=https://ecluqurlfbvkxrnoyhaq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVjbHVxdXJsZmJ2a3hybm95aGFxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ3ODQ0MzUsImV4cCI6MjA5MDM2MDQzNX0.XspsrkDjv_AWltPgFqBQSocLXU4tBmq1auu_Zg8qTBE

# CARTO Basemaps (issue #472). Public by necessity — Leaflet builds the tile
# URL in the browser, so this ships in the client bundle whatever we do;
# CARTO protects it with a domain restriction to studentx.uk, not secrecy.
# Same category as the anon key above. NEXT_PUBLIC_* are inlined at BUILD
# time, and this file is what supplies them to the Cloudflare build —
# a wrangler.jsonc var is a RUNTIME binding and never reaches it.
NEXT_PUBLIC_CARTO_KEY=cb1_2ypu_1_adbddc7f0fc4aa172f9d85ad
